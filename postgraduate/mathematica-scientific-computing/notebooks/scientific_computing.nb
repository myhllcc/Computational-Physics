Cell[BoxData[{
 RowBox[{
  RowBox[{"numberelectrons", " ", "=", " ", "1000"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"electronsInitial", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", "numberelectrons"}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{"electronsInitial", " ", "=", " ", 
    RowBox[{"Insert", "[", 
     RowBox[{"electronsInitial", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
