Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"2", " ", "c"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"finalXPx", "[", 
    RowBox[{"{", 
     RowBox[{"xinit_", ",", "pxinit_"}], "}"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pz", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"pTotal", "^", "2"}], "-", 
          RowBox[{"pxinit", "^", "2"}]}], "]"}]}], ",", "Sol", ",", "vx0", 
       ",", "vz0", ",", "xfunction", ",", "vzfunction", ",", "pxfinal", ",", 
       "vxfinal"}], "}"}], ",", 
     RowBox[{
      RowBox[{"vx0", "=", 
       RowBox[{"pxinit", "/", 
        RowBox[{"(", 
         RowBox[{"m", "*", "gamma"}], ")"}]}]}], ";", 
      RowBox[{"vz0", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"v", "^", "2"}], "-", 
         RowBox[{"vx0", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"q", "*", 
             RowBox[{"vz", "[", "z", "]"}], "*", "By"}], "==", 
            RowBox[{
             RowBox[{"-", "m"}], "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"vz", "[", "z", "]"}], "*", 
                RowBox[{
                 RowBox[{"vz", "'"}], "[", "z", "]"}], "*", 
                RowBox[{
                 RowBox[{"x", "'"}], "[", "z", "]"}]}], "+", 
               RowBox[{
                RowBox[{
                 RowBox[{"vz", "[", "z", "]"}], "^", "2"}], "*", 
                RowBox[{
                 RowBox[{"x", "''"}], "[", "z", "]"}]}]}], ")"}], "*", 
             "gamma"}]}], ",", 
           RowBox[{
            RowBox[{"q", "*", 
             RowBox[{"vz", "[", "z", "]"}], "*", 
             RowBox[{
              RowBox[{"x", "'"}], "[", "z", "]"}], "*", "By"}], "==", 
            RowBox[{"m", "*", 
             RowBox[{"vz", "[", "z", "]"}], "*", 
             RowBox[{
              RowBox[{"vz", "'"}], "[", "z", "]"}], "*", "gamma"}]}], ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "==", "xinit"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "0", "]"}], "==", 
            RowBox[{"vx0", "/", "vz0"}]}], ",", 
           RowBox[{
            RowBox[{"vz", "[", "0", "]"}], "==", "vz0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "vz"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xfunction", ":=", 
       RowBox[{"x", "/.", 
        RowBox[{
         RowBox[{"Sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vzfunction", ":=", 
       RowBox[{"vz", "/.", 
        RowBox[{
         RowBox[{"Sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vxfinal", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"v", "^", "2"}], "-", 
         RowBox[{
          RowBox[{"vzfunction", "[", "1", "]"}], "^", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pxfinal", "=", 
       RowBox[{"gamma", "*", "m", "*", "vxfinal"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xfunction", "[", "1", "]"}], ",", "pxfinal"}], "}"}]}]}], 
    "]"}]}]}]], "Input",
