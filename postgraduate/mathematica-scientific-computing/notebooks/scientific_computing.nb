         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.0007"}], ",", "0.0007"}], "}"}], "]"}]}], "}"}], 
      ",", 
      RowBox[{"-", "1"}]}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
