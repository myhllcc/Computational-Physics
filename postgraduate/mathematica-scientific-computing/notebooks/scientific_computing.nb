 RowBox[{
  RowBox[{"(*", 
   RowBox[{"3", "c"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"protonsEnergytotal", " ", "=", " ", 
     RowBox[{"protonsEnergy", " ", "+", " ", "mass"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"length", " ", "=", " ", "2.664"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", " ", "=", " ", "299792458"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"velocity", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gamma", "^", "2"}], "-", "1"}], ")"}], "]"}], "/", 
       "gamma"}], "*", "c"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"time", " ", "=", " ", 
